    <footer class="muted small center" style="margin-top:28px">
      <a href="/privacy">Privacy</a>
    </footer>
  </main>

  <div id="confirm-modal" class="modal-overlay" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="confirm-text">
