<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light dark">
  <meta name="robots" content="noindex, nofollow">
  <title><%= typeof title !== 'undefined' ? title : 'RSVP' %> · RSVP</title>
  <% var _v = (typeof assetVer !== 'undefined' && assetVer) ? ('?v=' + assetVer) : ''; %>
  <meta name="theme-color" content="#2563eb">
  <link rel="icon" href="/favicon.svg<%= _v %>" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="stylesheet" href="/app.css<%= _v %>">
  <script src="/app.js<%= _v %>"></script>
  <% if (typeof turnstile !== 'undefined' && turnstile) { %>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <% } %>
</head>
<body class="theme-<%= (typeof theme !== 'undefined' && theme) ? theme : 'app' %>">
  <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Colour scheme">🌗 Auto</button>
  <main class="page<%= (typeof wide !== 'undefined' && wide) ? ' page-wide' : '' %>">
