<%- include('../partials/head', { title: 'Admin' }) %>
<%- include('../partials/appnav') %>

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px">
  <h1 style="margin:0">Admin</h1>
  <a class="btn" href="/admin/events">All events</a>
</div>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; gap:10px">
    <div><strong>New signups:</strong> <%= paused ? 'Paused ⛔' : 'Open ✅' %></div>
    <form method="post" action="/admin/killswitch">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-sm"><%= paused ? 'Resume signups' : 'Pause signups' %></button>
    </form>
  </div>
</div>

<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; gap:10px">
    <div><strong>Email (free tier):</strong> <%= emailCapped ? 'Monthly limit reached ⛔' : 'OK ✅' %></div>
    <% if (emailCapped) { %>
    <form method="post" action="/admin/email/clear">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-sm">Clear block</button>
    </form>
    <% } %>
  </div>
  <% if (emailCapped) { %><p class="muted small" style="margin:6px 0 0">Email invites, reminders and new email events are paused until next month. Clear this if you've upgraded your Resend plan.</p><% } %>
</div>

<h2>Pending requests (<%= pending.length %>)</h2>
<% if (!pending.length) { %>
  <div class="card"><p class="muted">No pending requests right now.</p></div>
<% } %>

<% pending.forEach(function (o) { %>
  <div class="card">
    <div><strong><%= o.email %></strong><% if (o.display_name) { %> — <%= o.display_name %><% } %></div>
    <div class="muted small">requested <%= o.created_at %></div>
    <div class="btn-row" style="margin-top:10px">
      <form class="inline-form" method="post" action="/admin/organisers/<%= o.id %>/approve">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-sm btn-primary">Approve</button>
      </form>
      <form class="inline-form" method="post" action="/admin/organisers/<%= o.id %>/reject" data-confirm="Reject this request? (No email is sent.)">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn-sm btn-danger">Reject</button>
      </form>
    </div>
  </div>
<% }) %>

<%- include('../partials/foot') %>
