# ─────────────────────────────────────────────────────────────
#  RSVP system — configuration
#  Copy this file to `.env` and fill in real values.
#  NEVER commit your real `.env` (it is git-ignored).
# ─────────────────────────────────────────────────────────────

# --- Core ---
# Port the app listens on (bound to 127.0.0.1 only — exposed via Cloudflare Tunnel).
PORT=3000
# Public base URL of the site, used to build shareable links (no trailing slash).
BASE_URL=https://rsvp.example.com
# IANA timezone used to display all dates/times (e.g. Australia/Perth, Europe/London).
APP_TZ=Australia/Perth
# Session/CSRF signing secret — set to a long random string (e.g. `openssl rand -hex 32`).
SECRET=change-me-to-a-long-random-string

# --- Admin / authorisation ---
# The email address that has full admin rights (must match a Cloudflare Access identity).
ADMIN_EMAIL=admin@example.com

# --- Cloudflare Access (organiser/admin authentication) ---
# Your Zero Trust team domain, e.g. https://yourteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=https://yourteam.cloudflareaccess.com
# The Access application's Audience (AUD) tag — found in the Access app settings.
CF_ACCESS_AUD=your-access-application-aud-tag
# Set to "true" ONLY for local development to bypass Cloudflare Access and use DEV_EMAIL.
DEV_BYPASS_AUTH=false
# The email to assume when DEV_BYPASS_AUTH=true (simulate admin/organiser locally).
DEV_EMAIL=admin@example.com

# --- Cloudflare Turnstile (captcha on the request form) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email (transactional — admin alerts + approval notices) ---
# Uses Resend (https://resend.com). Leave RESEND_API_KEY blank to disable email (logs instead).
RESEND_API_KEY=
# The From address for outgoing mail (must be a verified sender/domain in Resend).
MAIL_FROM=RSVP <no-reply@example.com>

# --- Retention ---
# Days after an event's date before it and its guests are automatically purged.
PURGE_DAYS=30

# --- Abuse & scale caps (tunable) ---
MAX_ACTIVE_EVENTS_PER_ORG=10
MAX_GUESTS_PER_EVENT=250
MAX_GUESTS_PER_REQUEST=500
MAX_EVENTS_PER_DAY=5
MAX_SIGNUPS_PER_DAY=20
GLOBAL_ACTIVE_EVENT_CAP=200
MAX_RSVP_EDITS_PER_HOUR=20
